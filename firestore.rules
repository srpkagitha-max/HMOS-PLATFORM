rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActiveSuperAdmin() {
      return signedIn() && (
        request.auth.token.email == 'hmos.superadmin@gmail.com' ||
        (userDoc().data.userType == 'superAdmin' && userDoc().data.accountStatus == 'active')
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isActiveSuperAdmin());
      allow create, update, delete: if false;
    }

    match /institutes/{instituteId} {
      allow get: if true;
      allow list, create: if isActiveSuperAdmin();
      allow update: if isActiveSuperAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStudents', 'updatedAt']) &&
        request.resource.data.currentStudents == resource.data.currentStudents + 1 &&
        request.resource.data.currentStudents <= resource.data.studentLimit
      );
      allow delete: if false;
    }

    match /instituteAccess/{instituteCode} {
      allow get: if true;
      allow list: if false;
      allow create: if isActiveSuperAdmin();
      allow update: if isActiveSuperAdmin() || (
        resource.data.status == 'active' &&
        request.resource.data.instituteId == resource.data.instituteId &&
        request.resource.data.instituteCode == resource.data.instituteCode &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['passwordHash', 'mustChangePassword', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /admissions/{admissionId} {
      allow create: if request.resource.data.admissionId == admissionId
        && request.resource.data.instituteCode is string
        && request.resource.data.instituteId is string
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.parentPhone is string
        && request.resource.data.status == 'approved'
        && request.resource.data.studentAccountCreated == true;
      allow read, update, delete: if isActiveSuperAdmin();
    }

    match /students/{studentId} {
      allow get: if true;
      allow list: if isActiveSuperAdmin();
      allow create: if request.resource.data.studentId == studentId
        && request.resource.data.instituteId is string
        && request.resource.data.instituteCode is string
        && request.resource.data.studentName is string
        && request.resource.data.accountStatus == 'active';
      allow update, delete: if isActiveSuperAdmin();
    }

    match /studentAccess/{studentId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.studentId == studentId
        && request.resource.data.instituteId is string
        && request.resource.data.passwordHash is string
        && request.resource.data.mustChangePassword == true
        && request.resource.data.accountStatus == 'active';
      allow update, delete: if isActiveSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
