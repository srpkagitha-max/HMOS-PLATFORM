rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isSuperAdmin(){ return signedIn() && request.auth.token.email == "hmos.superadmin@gmail.com"; }
    match /users/{id} { allow read: if signedIn(); allow write: if isSuperAdmin(); }
    match /institutes/{id} { allow get: if true; allow list, create, delete: if isSuperAdmin(); allow update: if isSuperAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentStudents","updatedAt"]); }
    match /instituteAccess/{code} { allow get: if true; allow list: if false; allow create, delete: if isSuperAdmin(); allow update: if isSuperAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["passwordHash","mustChangePassword","instituteName","upiId","defaultTotalFees","adminId","adminPasswordHash","adminUpdatedAt","shareInstituteId","shareInstitutePassword","payeeName","paymentContact","paymentQrDataUrl","updatedAt"]); }
    match /admissions/{id} { allow create: if request.resource.data.admissionId == id && request.resource.data.studentId is string && request.resource.data.instituteCode is string; allow get: if true; allow list, update, delete: if isSuperAdmin(); }
    match /students/{studentId} { allow create: if request.resource.data.studentId == studentId && request.resource.data.instituteCode is string; allow get, list: if true; allow update: if isSuperAdmin() || request.resource.data.instituteCode == resource.data.instituteCode; allow delete: if isSuperAdmin(); }
    match /studentAccess/{studentId} { allow get: if true; allow list: if false; allow create: if request.resource.data.studentId == studentId && request.resource.data.passwordHash is string; allow update: if isSuperAdmin() || (request.resource.data.studentId == resource.data.studentId && request.resource.data.instituteCode == resource.data.instituteCode); allow delete: if isSuperAdmin(); }
    match /rooms/{roomId} { allow get, list: if true; allow create: if request.resource.data.roomId == roomId && request.resource.data.instituteCode is string && request.resource.data.capacity is int; allow update: if request.resource.data.instituteCode == resource.data.instituteCode; allow delete: if isSuperAdmin(); }
    match /roomAllotments/{studentId} { allow get: if true; allow list: if false; allow create, update: if request.resource.data.studentId == studentId && request.resource.data.instituteCode is string; allow delete: if isSuperAdmin(); }
    match /fees/{studentId} { allow get, list: if true; allow create, update: if request.resource.data.studentId == studentId && request.resource.data.instituteCode is string; allow delete: if isSuperAdmin(); }
    match /payments/{paymentId} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /instituteBranding/{code} { allow get: if true; allow list: if false; allow create, update: if request.resource.data.instituteCode == code; allow delete: if isSuperAdmin(); }
    match /pendingAdmissions/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /dailyMenus/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /mealAttendance/{id} { allow get, list, create: if true; allow update, delete: if isSuperAdmin(); }
    match /movements/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /complaints/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /approvalRequests/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /notifications/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /auditLogs/{id} { allow get, list, create: if true; allow update, delete: if isSuperAdmin(); }
    match /deletedRecords/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /backupJobs/{id} { allow get, list, create, update: if true; allow delete: if isSuperAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
